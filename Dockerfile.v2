FROM --platform=$BUILDPLATFORM node:22-alpine3.21 AS web-v2
WORKDIR /usr/src/paisa/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/ .
RUN npx svelte-kit sync && npm run build

FROM nginx:alpine
COPY --from=web-v2 /usr/src/paisa/frontend/build /usr/share/nginx/html
COPY nginx-v2.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
